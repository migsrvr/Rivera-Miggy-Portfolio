{
  "name": "rivera-2026-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Miggy Rivera's centered monochrome portfolio.",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs",
    "test": "node --test tests/*.test.mjs tests/backend/core.test.mjs tests/backend/http.test.mjs",
    "check": "node scripts/check.mjs",
    "test:integration": "node --env-file-if-exists=.local/test-db.env --test --test-concurrency=1 tests/backend/database.test.mjs tests/backend/setup.test.mjs tests/backend/auth-race.test.mjs tests/backend/integration.test.mjs",
    "setup:local": "node scripts/local-setup.mjs",
    "owner:setup": "node scripts/setup-owner.mjs",
    "owner:generate": "node scripts/setup-owner.mjs --generate",
    "seed": "node scripts/seed-content.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "content:import": "node scripts/import-content.mjs",
    "owner:preserve": "node scripts/setup-owner.mjs --preserve"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "fastify": "^5.12.7",
    "file-type": "^22.2.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
