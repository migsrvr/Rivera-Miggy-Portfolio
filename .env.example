# Server-only Neon connection. Set this in .env or .env.local; never in browser code.
DATABASE_URL=postgresql://OWNER:PASSWORD@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://127.0.0.1:4173
HOST=127.0.0.1
PORT=4173

# Optional: local disposable PostgreSQL for integration tests only.
# TEST_DATABASE_URL=postgresql://test_user:test_password@127.0.0.1:55432/portfolio_test
